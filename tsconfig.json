{
  "compilerOptions": {
    // "target": "es5",
    "ignoreDeprecations": "6.0",
    "target": "ES6",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "",
  },
  "include": [
    "svgr.d.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "js/utils/downloadPdf.js",
    "components/page/worksDepartment/contracList/contract/workSheet/productForm",
    // "js/pdf-worker.js"
    // "/pdf-worker.js"
  ],
  "exclude": [
    "node_modules",
    "z_deprecated",
    "z_ignore",
  ]
}